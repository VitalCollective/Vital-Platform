{
  "name": "vital-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "community:seed": "node scripts/community/seed.mjs",
    "community:test": "node --test scripts/community/seed.test.mjs",
    "community:test:db": "node --test scripts/community/database.test.mjs scripts/community/migration-guards.test.mjs scripts/community/profile-images.test.mjs scripts/community/blocks.test.mjs",
    "community:test:blocks": "node --test scripts/community/blocks.test.mjs",
    "account-deletion:test": "node --test apps/mobile/tests/account-deletion.test.mjs",
    "account-deletion:test:db": "node --test scripts/community/account-deletion.test.mjs",
    "family:test:db": "node --test scripts/account/family-members.test.mjs",
    "content:import:build": "tsc -p scripts/import-content/tsconfig.build.json",
    "content:import": "npm run content:import:build --silent && node scripts/import-content/.build/src/cli.js",
    "content:import:dry-run": "npm run content:import -- --dry-run",
    "content:storage:dry-run": "npm run content:import -- --upload-storage --dry-run",
    "content:import:test": "npm run content:import:build --silent && node --test scripts/import-content/.build/tests/import-content.test.js scripts/import-content/.build/tests/storage.test.js",
    "content:import:typecheck": "tsc -p scripts/import-content/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/node": "^26.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "supabase": "^2.115.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "csv-parse": "^7.0.2",
    "pdf-lib": "^1.17.1"
  }
}
